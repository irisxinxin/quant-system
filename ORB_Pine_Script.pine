//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  ORB - Opening Range Breakout 开盘区间突破策略信号
// ═══════════════════════════════════════════════════════════════════════
//  逻辑:
//    1. 开盘前 15 分钟 (9:30-9:45 ET) 形成 Opening Range (OR)
//    2. 9:45 后价格突破 OR 上沿 + RVOL ≥ 1.5 → 多头信号
//    3. 止损 = OR 下沿, 止盈 = 入场 + 2 × OR 范围
//    4. OR 过窄 (<0.3%) 自动跳过
//
//  用法:
//    1. 5m 图表 (必须)
//    2. 添加此指标
//    3. 在 "警报" 里为每只股票设置 警报 → 条件选 "🚀 多头突破"
//    4. 推送到手机 TradingView App
//
//  适合标的: OKLO, IREN, CIFR, CRWV, NBIS, HOOD, PLTR, TSLL
// ═══════════════════════════════════════════════════════════════════════

indicator("ORB 开盘区间突破", shorttitle="ORB", overlay=true,
          max_lines_count=100, max_labels_count=50, max_boxes_count=50)

// ═══════════════════════ 输入参数 ═══════════════════════
grp1 = "⚙️ OR 参数"
orMinutes     = input.int(15,  "OR 分钟数", minval=5, maxval=60, step=5, group=grp1)
minORRangePct = input.float(0.3, "OR 最小范围 %", minval=0.1, step=0.1, group=grp1,
                             tooltip="OR 范围 < 此值视为过窄，跳过当天")

grp2 = "🎯 入场/出场"
targetR       = input.float(2.0, "止盈 R 倍数", minval=1.0, step=0.5, group=grp2)
longOnly      = input.bool(true, "只做多 (不发空头信号)", group=grp2)

grp3 = "📊 量能过滤"
rvolThreshold = input.float(1.5, "RVOL 门槛", minval=1.0, step=0.1, group=grp3)
rvolLookback  = input.int(20, "RVOL 回看 K 线数", minval=10, maxval=50, group=grp3)

grp4 = "🎨 显示"
showORLines    = input.bool(true, "显示 OR 上下沿线", group=grp4)
showEntryLines = input.bool(true, "显示入场/止损/止盈线", group=grp4)
showTable      = input.bool(true, "显示状态表格", group=grp4)
showLabels     = input.bool(true, "突破时显示标签", group=grp4)

// ═══════════════════════ 时区与会话检测 ═══════════════════════
// 美股常规交易时段: 9:30-16:00 ET
// OR 窗口: 9:30-9:45 ET (周一到周五)
// Pine Script 会话格式: "HHMM-HHMM:DaysOfWeek", 1=周日, 2=周一 ... 6=周五

orSession     = "0930-0945:23456"
tradeSession  = "0945-1555:23456"   // 可交易窗口 (避开最后5分钟)
anySession    = "0930-1600:23456"

inORWindow    = not na(time(timeframe.period, orSession,    "America/New_York"))
inTradeWindow = not na(time(timeframe.period, tradeSession, "America/New_York"))
inRegular     = not na(time(timeframe.period, anySession,   "America/New_York"))

// ═══════════════════════ OR 计算 ═══════════════════════
var float orHigh      = na
var float orLow       = na
var float orRangeAbs  = na
var float orRangePct  = na
var bool  orFormed    = false
var bool  tooNarrow   = false
var bool  breakoutAlerted = false
var int   orBarCount  = 0

// 检测新的 OR 窗口开始
justEnteredOR = inORWindow and not inORWindow[1]
justLeftOR    = not inORWindow and inORWindow[1]

// 新的一天, 重置
if justEnteredOR
    orHigh := high
    orLow := low
    orRangeAbs := na
    orRangePct := na
    orFormed := false
    tooNarrow := false
    breakoutAlerted := false
    orBarCount := 1

// OR 窗口内持续更新
else if inORWindow
    orHigh := math.max(nz(orHigh, high), high)
    orLow  := math.min(nz(orLow, low), low)
    orBarCount := orBarCount + 1

// OR 窗口刚结束, 计算范围 + 判断是否过窄
if justLeftOR
    orRangeAbs := orHigh - orLow
    orRangePct := orRangeAbs / ((orHigh + orLow) / 2) * 100
    tooNarrow := orRangePct < minORRangePct
    orFormed := true

// ═══════════════════════ RVOL 计算 (lenient: 跨天滚动 SMA 20, 含当前) ═══════════════════════
// 与限价 stop-buy 入场组合下回测最优 — 与 Python live 脚本算法一致
avgVol = ta.sma(volume, rvolLookback)
rvol   = volume / (avgVol == 0 ? 1 : avgVol)

// ═══════════════════════ 突破检测 ═══════════════════════
// 满足: OR 已成型 + 不过窄 + 未触发过 + 在交易窗口 + 价格破 OR High + RVOL 够
longBreakoutRaw  = orFormed and not tooNarrow and not breakoutAlerted and inTradeWindow and high > orHigh and close > orHigh and rvol >= rvolThreshold

shortBreakoutRaw = orFormed and not tooNarrow and not breakoutAlerted and inTradeWindow and not longOnly and low < orLow and close < orLow and rvol >= rvolThreshold

longBreakout  = longBreakoutRaw and not breakoutAlerted[1]
shortBreakout = shortBreakoutRaw and not breakoutAlerted[1]

// 入场参数
var float entryPrice = na
var float stopPrice  = na
var float tpPrice    = na
var string direction = na

if longBreakout
    entryPrice := orHigh
    stopPrice  := orLow
    tpPrice    := orHigh + targetR * orRangeAbs
    direction  := "LONG"
    breakoutAlerted := true

if shortBreakout
    entryPrice := orLow
    stopPrice  := orHigh
    tpPrice    := orLow - targetR * orRangeAbs
    direction  := "SHORT"
    breakoutAlerted := true

// ═══════════════════════ 绘图 ═══════════════════════
// OR 上下沿 (只在 OR 成型后且未过窄时画)
plot(showORLines and orFormed and not tooNarrow ? orHigh : na,
     title="OR High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(showORLines and orFormed and not tooNarrow ? orLow : na,
     title="OR Low",  color=color.new(color.red, 0),   linewidth=2, style=plot.style_linebr)

// OR 范围填充 — 每天只创建一次, 然后右延伸 (避免每根 K 线叠新 box 出"竖线")
var box orBox = na
if justEnteredOR and not na(orBox)
    box.delete(orBox)
    orBox := na
if justLeftOR and not tooNarrow and showORLines
    orBox := box.new(left=bar_index - orBarCount, top=orHigh,
         right=bar_index, bottom=orLow,
         bgcolor=color.new(color.gray, 92),
         border_color=color.new(color.gray, 70))
if not na(orBox)
    box.set_right(orBox, bar_index)

// 入场/止损/止盈线 (突破后显示)
plot(showEntryLines and not na(entryPrice) ? entryPrice : na,
     title="Entry", color=color.blue, linewidth=2, style=plot.style_circles)
plot(showEntryLines and not na(stopPrice) ? stopPrice : na,
     title="Stop",  color=color.red,  linewidth=2, style=plot.style_circles)
plot(showEntryLines and not na(tpPrice) ? tpPrice : na,
     title="TP",    color=color.green, linewidth=2, style=plot.style_circles)

// OR 窗口背景
bgcolor(inORWindow ? color.new(color.yellow, 90) : na, title="OR 形成中")
bgcolor(orFormed and tooNarrow ? color.new(color.gray, 92) : na, title="OR 过窄 SKIP")

// 突破标签
if longBreakout and showLabels
    label.new(bar_index, high,
         text="🚀 多头突破\n"
            + "Entry: " + str.tostring(entryPrice, format.mintick) + "\n"
            + "Stop:  " + str.tostring(stopPrice,  format.mintick)
            + " (-" + str.tostring((entryPrice - stopPrice)/entryPrice * 100, "#.##") + "%)\n"
            + "TP:    " + str.tostring(tpPrice,    format.mintick)
            + " (+" + str.tostring((tpPrice - entryPrice)/entryPrice * 100, "#.##") + "%)\n"
            + "RVOL:  " + str.tostring(rvol, "#.##")
            + "  OR: "  + str.tostring(orRangePct, "#.##") + "%",
         style=label.style_label_down, color=color.green, textcolor=color.white, size=size.normal)

if shortBreakout and showLabels
    label.new(bar_index, low,
         text="📉 空头突破\n"
            + "Entry: " + str.tostring(entryPrice, format.mintick) + "\n"
            + "Stop:  " + str.tostring(stopPrice,  format.mintick) + "\n"
            + "TP:    " + str.tostring(tpPrice,    format.mintick) + "\n"
            + "RVOL:  " + str.tostring(rvol, "#.##"),
         style=label.style_label_up, color=color.red, textcolor=color.white, size=size.normal)

// ═══════════════════════ 状态表格 ═══════════════════════
var table infoTable = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 75), border_width=1, frame_color=color.gray)

if showTable and barstate.islast
    statusText = inORWindow ? "🟡 OR 形成中 (" + str.tostring(orBarCount) + "根)"
      : orFormed and tooNarrow ? "⚪ OR 过窄 SKIP"
      : orFormed and breakoutAlerted ? "🟢 已突破 " + direction
      : orFormed ? "🔵 监测突破中"
      : "⏸️ 等待开盘"

    table.cell(infoTable, 0, 0, "ORB 状态", bgcolor=color.new(color.blue, 30), text_color=color.white)
    table.cell(infoTable, 1, 0, statusText, text_color=color.white)

    table.cell(infoTable, 0, 1, "OR High", text_color=color.white)
    table.cell(infoTable, 1, 1, na(orHigh) ? "-" : str.tostring(orHigh, format.mintick),
        text_color=color.new(color.green, 0))

    table.cell(infoTable, 0, 2, "OR Low", text_color=color.white)
    table.cell(infoTable, 1, 2, na(orLow) ? "-" : str.tostring(orLow, format.mintick),
        text_color=color.new(color.red, 0))

    table.cell(infoTable, 0, 3, "OR 范围 %", text_color=color.white)
    table.cell(infoTable, 1, 3, na(orRangePct) ? "-" : str.tostring(orRangePct, "#.##") + "%",
        text_color=tooNarrow ? color.gray : color.white)

    table.cell(infoTable, 0, 4, "当前 RVOL", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(rvol, "#.##"),
        text_color=(rvol >= rvolThreshold ? color.green : color.gray))

    table.cell(infoTable, 0, 5, "入场价", text_color=color.white)
    table.cell(infoTable, 1, 5, na(entryPrice) ? "-" : str.tostring(entryPrice, format.mintick),
        text_color=color.new(color.blue, 0))

    table.cell(infoTable, 0, 6, "止损价", text_color=color.white)
    table.cell(infoTable, 1, 6, na(stopPrice) ? "-" : str.tostring(stopPrice, format.mintick),
        text_color=color.new(color.red, 0))

    table.cell(infoTable, 0, 7, "止盈价", text_color=color.white)
    table.cell(infoTable, 1, 7, na(tpPrice) ? "-" : str.tostring(tpPrice, format.mintick),
        text_color=color.new(color.green, 0))

// ═══════════════════════ 警报条件 ═══════════════════════
// 在 TradingView 界面右键图表 → 创建警报 → 条件选下面任一 → 选 "Once Per Bar Close"
alertcondition(longBreakout,
     title="🚀 多头突破 LONG",
     message="🚀 {{ticker}} 多头突破 ORB!\n"
           + "时间: {{time}}\n"
           + "入场: {{plot_0}}\n"
           + "止损: {{plot_1}}\n"
           + "止盈: {{plot_2}}\n"
           + "当前价: {{close}}")

alertcondition(shortBreakout,
     title="📉 空头突破 SHORT",
     message="📉 {{ticker}} 空头突破 ORB!\n"
           + "时间: {{time}}\n"
           + "入场: {{plot_0}}\n"
           + "止损: {{plot_1}}\n"
           + "止盈: {{plot_2}}\n"
           + "当前价: {{close}}")

alertcondition(justLeftOR and not tooNarrow,
     title="🟡 OR 已形成",
     message="🟡 {{ticker}} OR 已形成!\n"
           + "High: {{plot_0}}\n"
           + "Low: {{plot_1}}\n"
           + "范围: 见指标表")
