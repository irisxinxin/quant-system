//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  ORB Strategy — Opening Range Breakout 完整策略版 (含 backtest)
// ═══════════════════════════════════════════════════════════════════════
//  和 indicator 版区别:
//    - 这是 strategy() 类型, 内置 backtest 引擎
//    - TradingView "Strategy Tester" 面板会显示:
//        Net Profit / Total Trades / Win Rate / PF / Max DD / Sharpe / 等
//    - 警报触发时, 推送到手机 TradingView App
//
//  使用步骤:
//    1. 5m 图表 (必须)
//    2. 添加此策略 (Pine 编辑器粘贴 → "添加到图表")
//    3. 在 "策略测试" 面板看回测数据
//    4. 右键图表 → 创建警报 → 选 "🚀 多头突破" → 确认
//    5. 手机 TradingView App 登录同账号, 推送通知打开
//
//  推荐应用到这些股票 (按你 Python 系统的核心组合):
//    AMZN  PLTR  RKLB  IREN  INTC  TSLL  TSLZ  SOXL  SOXS
// ═══════════════════════════════════════════════════════════════════════

strategy(
     title              = "ORB Strategy 短线",
     shorttitle         = "ORB",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 100,             // 每笔满仓 (回测用)
     pyramiding         = 0,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.05,
     slippage           = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_lines_count    = 100,
     max_labels_count   = 100,
     max_boxes_count    = 50)

// ═══════════════════════════════════════════════════════════════════════
// 输入参数
// ═══════════════════════════════════════════════════════════════════════

grp1 = "⚙️ OR 参数"
orMinutes      = input.int(15,   "OR 分钟数",     minval=5, maxval=60, step=5,  group=grp1)
minORRangePct  = input.float(0.3,"OR 最小范围 %", minval=0.1, step=0.1,         group=grp1,
                              tooltip="OR 范围 < 此值视为过窄, 跳过")

grp2 = "🎯 入场/出场"
targetR        = input.float(2.0,"止盈 R 倍数",   minval=1.0, step=0.5,         group=grp2)
longOnly       = input.bool(true,"只做多",                                       group=grp2)
useEodExit     = input.bool(true,"日末强制平仓 (15:55 ET)",                      group=grp2)

grp3 = "📊 量能"
rvolThreshold  = input.float(1.5,"RVOL 门槛", minval=1.0, step=0.1, group=grp3)
rvolLookback   = input.int(20,   "RVOL 回看 K 线数", minval=10, maxval=50, group=grp3)

grp4 = "🎨 显示"
showORLines    = input.bool(true,"显示 OR 上下沿",         group=grp4)
showLabels     = input.bool(true,"突破时画标签",            group=grp4)

// ═══════════════════════════════════════════════════════════════════════
// 时段检测
// ═══════════════════════════════════════════════════════════════════════
orSession    = "0930-0945:23456"
tradeSession = "0945-1555:23456"

inORWindow    = not na(time(timeframe.period, orSession,    "America/New_York"))
inTradeWindow = not na(time(timeframe.period, tradeSession, "America/New_York"))

// ═══════════════════════════════════════════════════════════════════════
// OR 计算
// ═══════════════════════════════════════════════════════════════════════
var float orHigh = na
var float orLow = na
var float orRange = na
var float orRangePct = na
var bool orFormed = false
var bool tooNarrow = false
var int orBarCount = 0

justEnteredOR = inORWindow and not inORWindow[1]
justLeftOR = not inORWindow and inORWindow[1]

if justEnteredOR
    orHigh := high
    orLow := low
    orFormed := false
    tooNarrow := false
    orBarCount := 1
else if inORWindow
    orHigh := math.max(nz(orHigh, high), high)
    orLow := math.min(nz(orLow, low), low)
    orBarCount := orBarCount + 1

if justLeftOR
    orRange := orHigh - orLow
    orRangePct := orRange / ((orHigh + orLow) / 2) * 100
    tooNarrow := orRangePct < minORRangePct
    orFormed := true

// ═══════════════════════════════════════════════════════════════════════
// RVOL
// ═══════════════════════════════════════════════════════════════════════
avgVol = ta.sma(volume, rvolLookback)
rvol = volume / (avgVol == 0 ? 1 : avgVol)

// ═══════════════════════════════════════════════════════════════════════
// 突破检测 + 下单
// ═══════════════════════════════════════════════════════════════════════
canEnterLong = orFormed and not tooNarrow and inTradeWindow
                 and high > orHigh and close > orHigh
                 and rvol >= rvolThreshold
                 and strategy.position_size == 0

canEnterShort = orFormed and not tooNarrow and not longOnly and inTradeWindow
                  and low < orLow and close < orLow
                  and rvol >= rvolThreshold
                  and strategy.position_size == 0

if canEnterLong
    stopPrice = orLow
    tpPrice   = orHigh + targetR * orRange
    strategy.entry("Long", strategy.long, comment="BUY")
    strategy.exit("Long_Exit", from_entry="Long", stop=stopPrice, limit=tpPrice)

if canEnterShort
    stopPrice = orHigh
    tpPrice   = orLow - targetR * orRange
    strategy.entry("Short", strategy.short, comment="SELL")
    strategy.exit("Short_Exit", from_entry="Short", stop=stopPrice, limit=tpPrice)

// 日末平仓 (15:55 ET 之后)
isAfterEod = useEodExit and not inTradeWindow and inORWindow == false and orFormed
isNewDay = ta.change(dayofmonth(time("D", "America/New_York"))) != 0
if isNewDay and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ═══════════════════════════════════════════════════════════════════════
// 绘图
// ═══════════════════════════════════════════════════════════════════════
plot(showORLines and orFormed and not tooNarrow ? orHigh : na,
     title="OR High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(showORLines and orFormed and not tooNarrow ? orLow : na,
     title="OR Low",  color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

bgcolor(inORWindow ? color.new(color.yellow, 90) : na, title="OR 形成中")
bgcolor(orFormed and tooNarrow ? color.new(color.gray, 92) : na, title="OR 过窄")

if canEnterLong and showLabels
    label.new(bar_index, high,
         text="🚀 BUY\n" + str.tostring(orHigh, format.mintick)
            + "\nSL " + str.tostring(orLow, format.mintick)
            + "\nTP " + str.tostring(orHigh + targetR * orRange, format.mintick)
            + "\nRVOL " + str.tostring(rvol, "#.##"),
         style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════
// 状态表格
// ═══════════════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 75), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "ORB", bgcolor=color.new(color.blue, 30), text_color=color.white)
    table.cell(info, 1, 0, orFormed ? (tooNarrow ? "过窄" : "✅ 已成型") : "等待开盘", text_color=color.white)
    table.cell(info, 0, 1, "OR High", text_color=color.white)
    table.cell(info, 1, 1, na(orHigh) ? "-" : str.tostring(orHigh, format.mintick), text_color=color.green)
    table.cell(info, 0, 2, "OR Low", text_color=color.white)
    table.cell(info, 1, 2, na(orLow) ? "-" : str.tostring(orLow, format.mintick), text_color=color.red)
    table.cell(info, 0, 3, "OR 范围", text_color=color.white)
    table.cell(info, 1, 3, na(orRangePct) ? "-" : str.tostring(orRangePct, "#.##") + "%", text_color=color.white)
    table.cell(info, 0, 4, "RVOL", text_color=color.white)
    table.cell(info, 1, 4, str.tostring(rvol, "#.##"), text_color=(rvol >= rvolThreshold ? color.green : color.gray))
    table.cell(info, 0, 5, "持仓", text_color=color.white)
    posTxt = strategy.position_size > 0 ? "🟢 多" : (strategy.position_size < 0 ? "🔴 空" : "—")
    table.cell(info, 1, 5, posTxt, text_color=color.white)

// ═══════════════════════════════════════════════════════════════════════
// 警报
// ═══════════════════════════════════════════════════════════════════════
//
// 设置:
//   1. 添加策略到图表后, 右键图表 → 创建警报
//   2. 条件 选 "🚀 ORB 多头突破"
//   3. Trigger: "Once Per Bar Close"
//   4. Notifications: ✅ 显示弹窗, ✅ 发送到手机, ✅ 邮件 (可选)
//   5. 过期: 选 "永不过期"
//
//  消息会自动用 TradingView 占位符填充: {{ticker}} {{close}} {{plot_X}}
// ═══════════════════════════════════════════════════════════════════════

alertcondition(canEnterLong,
     title="🚀 ORB 多头突破",
     message="🚀 {{ticker}} BUY @ {{plot_0}} | SL {{plot_1}} | TP {{plot_2}} | 当前价 {{close}}")

alertcondition(canEnterShort,
     title="📉 ORB 空头突破",
     message="📉 {{ticker}} SELL @ {{plot_1}} | SL {{plot_0}} | 当前价 {{close}}")
