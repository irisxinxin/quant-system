//@version=5
// ════════════════════════════════════════════════════════════════════════════
//  Kova Essentials 复刻 — 四均线 + 健康度 + REDUCE + Score + 面板 + Telegram告警
//  反推自 Kova Investment Research 指标 (93样本校准, 健康度99%/Reduce98%)
//
//  ⚠ 这是主图 overlay 指标(画在K线上)。配合另两个副图指标一起用:
//     · kova_momentum_volume.pine 的【六色成交额柱】+【动能震荡器】(各一副图)
//     · 本指标 = 四均线 + Kova面板 + 告警
//
//  置信度(各维度):
//    · 四均线 10E/20E/50S/200S        1.00 (截图直读)
//    · 健康度 UNHEALTHY/HEALTHY        ~0.95 (93样本命中99%, 唯一miss=实时vs结算EMA边界)
//    · REDUCE 减仓                     0.90  (HEALTHY且dev21≥2.93ATR; 注:8独立事件,prod前先前向验证)
//    · WATCH 橙顶部预警                0.35  (仅1样本QQQ,最缺;阈值待补)
//    · Kova Score                      结构0.75/精确值~0.60 (缺Kova专有RS内部维度,IREN类异常复现不了)
//
//  Telegram: TradingView告警 → Webhook(你的服务器/PythonAnywhere) → Bot sendMessage
//            本指标用 alertcondition() 暴露4个事件, 创建告警时选对应condition即可。
// ════════════════════════════════════════════════════════════════════════════
indicator("Kova Essentials (反推)", overlay=true, max_labels_count=50)

// ── 输入 ──
showMA      = input.bool(true,  "显示四均线 10E/20E/50S/200S")
showPanel   = input.bool(true,  "显示 Kova 面板")
reduceDev   = input.float(2.93, "REDUCE 阈值: 距21EMA ATR数", step=0.05, tooltip="93样本锚定:最低MU 2.96 REDUCE / 最高MRVL 2.91 Hold → 2.93")
wCushion    = input.float(3.0,  "WATCH: 距20E垫子 <%", tooltip="顶部预警:贴20E")
wNearHigh   = input.float(-6.0, "WATCH: 距高 >%", tooltip="贴近高点")
wDistrib    = input.float(1.5,  "WATCH: 末柱量比 ≥", tooltip="放量派发")
showStop    = input.bool(true,  "显示建议止损(入场日K线低)")

// ── Kova Essentials 四均线 ──
e10  = ta.ema(close, 10)
e20  = ta.ema(close, 20)
s50  = ta.sma(close, 50)
s200 = ta.sma(close, 200)
e21  = ta.ema(close, 21)      // REDUCE/乖离用21EMA
plot(showMA ? e10  : na, "10 EMA", color.new(#26a69a, 0), 1)
plot(showMA ? e20  : na, "20 EMA", color.new(#ffa726, 0), 1)
plot(showMA ? s50  : na, "50 SMA", color.new(#42a5f5, 0), 2)
plot(showMA ? s200 : na, "200 SMA", color.new(#ab47bc, 0), 2)

// ── 特征 ──
atr14   = ta.atr(14)
hi250   = ta.highest(close, 250)
distHi  = (close / hi250 - 1) * 100              // 距250日高 %(≤0)
d20     = (close / e20 - 1) * 100                // 距20E %
dev21   = (close - e21) / atr14                  // 距21EMA 的 ATR 乖离
volMa   = ta.sma(volume, 20)
vr      = volume / volMa                          // 量比
a10 = close > e10
a20 = close > e20
a50 = close > s50
a200 = close > s200
hasBars = bar_index >= 200                         // 200SMA 需足够 bar

// ── 健康度三档 (反解公式) ──
//   UNHEALTHY = 破 20E / 50S / 200S 任一
//   WATCH(橙) = 在三线上方 但 破10E + 贴20E(垫子<3%) + 贴高(>-6%) + 放量派发(vr≥1.5)
//   HEALTHY   = 在三线上方 且 非WATCH
isUnhealthy = (not hasBars) or (not (a20 and a50 and a200))
isWatch     = (not isUnhealthy) and (not a10) and (d20 >= 0) and (d20 < wCushion) and (distHi > wNearHigh) and (vr >= wDistrib)
isHealthy   = (not isUnhealthy) and (not isWatch)
healthTxt   = isUnhealthy ? "UNHEALTHY" : isWatch ? "WATCH" : "HEALTHY"
healthCol   = isUnhealthy ? color.new(#ef5350, 0) : isWatch ? color.new(#ffa726, 0) : color.new(#26a69a, 0)

// ── REDUCE 减仓 (HEALTHY 且 延伸 ≥ 阈值) ──
isReduce = isHealthy and (dev21 >= reduceDev)

// ── Kova Score 代理 (结构公式; ⚠缺专有RS内部维度, 精确值~0.60) ──
//   Score ≈ 40.8 + 59.5·站200S + 5.6·站20E + 0.72·距高%  (R²≈0.89, 93样本)
scoreRaw = 40.8 + 59.5 * (a200 ? 1 : 0) + 5.6 * (a20 ? 1 : 0) + 0.72 * distHi
kScore   = math.max(1, math.min(99, math.round(scoreRaw)))

// ── 建议止损 = 入场日(当前最近放量突破日)K线低; 无持仓上下文时用最近 pocket pivot 低 ──
//   Kova止损法=入场当天K线低(23笔实盘验证 vs_entry_low中位-0.02ATR)。这里近似=最近一根强势放量阳线的低。
isEntryBar = close > open and vr >= 1.5 and close > e10
var float stopLevel = na
if isEntryBar
    stopLevel := low
plot(showStop and isHealthy ? stopLevel : na, "建议止损(入场K低)", color.new(#ef5350, 30), 1, style=plot.style_linebr)

// ── 状态背景 ──
bgcolor(isReduce ? color.new(#ffa726, 90) : na, title="REDUCE区")
bgcolor(isUnhealthy ? color.new(#ef5350, 94) : na, title="UNHEALTHY区")

// ── Kova 面板 (右上角, 仿原版) ──
var table panel = table.new(position.top_right, 2, 6, border_width=1)
f_row(r, k, v, vc) =>      // 全局作用域(Pine v5 禁止在if内定义函数)
    table.cell(panel, 0, r, k, text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "Kova", text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.normal, text_halign=text.align_right)
    f_row(1, "Score", str.tostring(kScore) + " ≈", isHealthy ? color.new(#26a69a,0) : color.gray)
    f_row(2, "健康度", healthTxt, healthCol)
    f_row(3, "信号", isReduce ? "REDUCE 减仓" : isUnhealthy ? "退出" : "持有", isReduce ? color.new(#ffa726,0) : isUnhealthy ? color.new(#ef5350,0) : color.new(#26a69a,0))
    f_row(4, "距21E", str.tostring(dev21, "#.##") + " ATR", dev21 >= reduceDev ? color.new(#ffa726,0) : color.gray)
    f_row(5, "距高", str.tostring(distHi, "#.#") + "%", color.gray)

// ── 转档信号标签 ──
turnedUnhealthy = isUnhealthy and not isUnhealthy[1]
turnedReduce    = isReduce and not isReduce[1]
turnedWatch     = isWatch and not isWatch[1]
if turnedReduce
    label.new(bar_index, high, "REDUCE", style=label.style_label_down, color=color.new(#ffa726,0), textcolor=color.white, size=size.small)
if turnedUnhealthy
    label.new(bar_index, high, "退出", style=label.style_label_down, color=color.new(#ef5350,0), textcolor=color.white, size=size.small)

// ── Telegram 告警条件 (创建告警时选对应 condition, Webhook 消息可用占位符) ──
alertcondition(turnedUnhealthy, "Kova 转 UNHEALTHY(退出)", '{"ticker":"{{ticker}}","signal":"UNHEALTHY_EXIT","price":{{close}}}')
alertcondition(turnedReduce,    "Kova REDUCE(减仓)",       '{"ticker":"{{ticker}}","signal":"REDUCE","price":{{close}}}')
alertcondition(turnedWatch,     "Kova 转 WATCH(顶部预警)",  '{"ticker":"{{ticker}}","signal":"WATCH","price":{{close}}}')
alertcondition(isHealthy and not isHealthy[1], "Kova 转 HEALTHY", '{"ticker":"{{ticker}}","signal":"HEALTHY","price":{{close}}}')
