<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.xin.enrichbot.plist — enrich Discord期权跟单bot (discord_enrich_bot.py), 常驻

  安装:
    cp bots/enrich/launchd/com.xin.enrichbot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.xin.enrichbot.plist
  日志: tail -f /Users/xin/Documents/Claude/Projects/money/quant_system/output/enrich_bot.log
  ⚠ 全程 LongPort 模拟盘 (启动三重校验 lb_papertrading, 不过即退; KeepAlive会重试)
  ⚠ 当前 ENRICH_LIVE=true (模拟盘真下单, 2026-07-20 21:35 SGT 切换)。这里的值必须和
    ~/Library/LaunchAgents/ 里那份一致 —— 否则下次 cp 安装会静默改变运行模式。
    要停下单只播报: 改成 false, 重新 cp + launchctl unload/load。
  ⚠ WorkingDirectory 保持仓库根: 状态文件 output/、K线 data/、归档的 git 操作都按根目录找。
  规则(2026-07-22 引擎修bug后重测定案 bt_be_grid + F不对称过夜): 进场跟站长限价不追高+TTL20分不接刀 |
  +30%卖½ → runner不保本(MECH_BE=0, 让它扛回撤接大runner如GOOGL) | 剩仓摸+60%武装 → 守15分9ema连破2根 |
  初始止损-50%(MECH_STOP_MULT=0.5) | 过夜阶梯(F_EOD_CLOSE_UNREDUCED=1, 非到期日15:40-16:00按剩仓收益g:
  g<30%全平不裸扛过夜避IBM式-94% / 30-50%留 / ≥50%砍半再留降险接肥尾) | 到期强平 | 无LLM | hedge当lotto跟⅓仓 | 站长出场只播报。
  2026-07-21 定稿(保本MECH_BE=1)因回测引擎缺武装门控bug→结论有误, 已修正; 2026-07-19 旧定稿(两档-60全程)更早被替换, 见 git。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xin.enrichbot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>source /Users/xin/.longport_creds.env &amp;&amp; export ENRICH_LIVE=true POSITION_FRAC=0.5 LOTTO_FRAC=0.3333 ZERO_DTE_FRAC=0.10 MECH_TP_MULT=1.3 MECH_TP_FRAC=0.5 MECH_TP2_MULT=1.6 MECH_BE=0 MECH_STOP_MULT=0.5 MECH_EMA_MIN=15 MECH_EMA_N=2 ENTRY_TTL_SEC=1200 F_EOD_CLOSE_UNREDUCED=1 &amp;&amp; exec /usr/bin/caffeinate -s /usr/local/bin/python3 /Users/xin/Documents/Claude/Projects/money/quant_system/bots/enrich/discord_enrich_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/xin/Documents/Claude/Projects/money/quant_system</string>

    <!-- 常驻: 崩了/断网退出后 30s 自动拉起; 开机自启 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/xin/Documents/Claude/Projects/money/quant_system/output/enrich_bot_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xin/Documents/Claude/Projects/money/quant_system/output/enrich_bot_stdout.log</string>
</dict>
</plist>
