// ============================================================================
//  Kova 动量维度复刻 — 六色成交额柱 + 动能震荡器(AD速度波)
//  反推自 Kova Investment Research 指标 (workflow 5-agent 校准, 35样本)
//
//  ⚠ 这是【两个独立指标】。TradingView → Pine 编辑器里新建两个指标,
//     分别复制下面【指标①】和【指标②】的代码块(各自含 //@version=5)。
//     两个都加到图上, 会各占一个副图(和 Kova 一样底部两条)。
//
//  置信度(动能: 719个结构锚点标定, gmax+gmin+有序极值+306粗点):
//    · 六色量柱  0.72  (末柱颜色 5/5 吻合, 紫/红有清晰空档)
//    · 动能·结构/方向  0.85  (719锚点z中位严格单调; AD速度波=震荡器已证实)
//    · 动能·外档亮蓝/深红 0.85  (最高柱→亮蓝 89%、最低柱→深红 84%, 钉死)
//    · 动能·近零档(浅红/浅/浅蓝) 0.62  (三档68%; 真上限=我的z是Kova未知公式的近似)
//  → 量柱+动能外档可放心用; 近零档天花板~65%, 因公式仅近似, 非数据不足。
// ============================================================================


// ============================================================================
//  【指标①】Kova 六色成交额柱  (置信 0.72 · 可放心用)
//  颜色 = 当日成交额 / 20日均成交额 的倍数 R, 配合涨跌方向 → 六色
//    涨日: R≥2.6 🟦亮蓝(机构追买/pocket pivot) | 1.6≤R<2.6 🟢中绿(明显放量涨) | R<1.6 ⬜浅(正常)
//    跌日: R≥2.6 🟥满红(派发/distribution)      | 1.6≤R<2.6 🔴中红(明显放量跌) | R<1.6 🟪亮紫(缩量=卖盘衰竭)
//  关键: 紫不是"量比<1×", 而是"<1.6×"=量没放大到足以确认这个方向(ARM/MU跌12%却只1.4x量=紫)
// ============================================================================
//@version=5
indicator("Kova 六色成交额柱 (反推)", overlay=false, format=format.volume, precision=0)

kM   = input.float(1.6, "明显放量阈 k_M", step=0.1, tooltip="紫/中 的分界, 由 MU(1.53紫)/SPY(2.0红)双向夹逼, 较可靠")
kS   = input.float(2.6, "S级放量阈 k_S", step=0.1, tooltip="中/S级 的分界, 仅QQQ(2.54中红)一个边界点, 不确定, 可在2.4-2.8间调")
mlen = input.int(20, "均量窗口", minval=5)
useTurnover = input.bool(true, "用成交额(×hlc3)而非纯股数", tooltip="Kova叫'成交额柱'; TV无原生turnover, 用 volume×hlc3 近似")

basis = useTurnover ? volume * hlc3 : volume
R = basis / ta.sma(basis, mlen)
up = close >= open

cBlue  = color.new(#2196f3, 0)   // 亮蓝  放量涨 S级
cGreen = color.new(#26a69a, 0)   // 中绿  明显放量涨
cLight = color.new(#5d6673, 35)  // 浅    正常涨
cRed   = color.new(#ef5350, 0)   // 满红  放量跌 S级(派发)
cMidR  = color.new(#e57373, 0)   // 中红  明显放量跌
cPurp  = color.new(#ab47bc, 0)   // 亮紫  缩量(卖盘衰竭)

barCol = up ? (R >= kS ? cBlue : R >= kM ? cGreen : cLight) : (R >= kS ? cRed : R >= kM ? cMidR : cPurp)
plot(volume, "量柱", color=barCol, style=plot.style_columns)
plot(ta.sma(volume, mlen), "20日均量", color=color.new(color.gray, 30), linewidth=1)


// ============================================================================
//  【指标②】Kova 动能震荡器 — AD速度波  (置信 0.85结构/0.62近零档)
//  = 累积/分布线(AD)的"速度" = EMA9(AD)−EMA21(AD), 再120日z标准化 (9/21=截图露出真参数)
//  胜过 OBV/CMF/MFI: AD用收盘在当日区间位置(CLV)加权, 高位放量收低=派发立刻压斜率
//  ── 七档颜色阈值 = 719个结构锚点标定(z中位严格单调, 留一图CV) ──
//    深红 z<−1.26 | 亮红[−1.26,−0.53) | 浅红[−0.53,−0.29) | 浅[−0.29,0.36)
//    浅蓝[0.36,1.14) | 深蓝[1.14,1.83) | 亮蓝 z≥1.83
//  验证: 图上最高柱→亮蓝(z≈+2.2) 89%命中, 最低柱→深红(z≈−1.9) 84%; 外档钉死, 近零档~65%上限
// ============================================================================
//@version=5
indicator("Kova 动能震荡器 AD速度波 (反推)", overlay=false)

fast = input.int(9, "AD 快 EMA")   // 截图露出真参数 9
slow = input.int(21, "AD 慢 EMA")  // 截图露出真参数 21
zlen = input.int(120, "z 标准化窗口")

clv = (high == low) ? 0.0 : ((close - low) - (high - close)) / (high - low)
ad  = ta.cum(clv * volume)
wave = ta.ema(ad, fast) - ta.ema(ad, slow)
z  = (wave - ta.sma(wave, zlen)) / ta.stdev(wave, zlen)

// 七档(深红→亮蓝), 阈值=719锚点标定的相邻档z中位中点
cDeepR = color.new(#a01020, 0)   // 深红 资金深度撤出
cBriR  = color.new(#e03b3b, 0)   // 亮红 加速撤出
cLitR  = color.new(#e08a8a, 0)   // 浅红 弱撤出
cFlat  = color.new(#9aa0aa, 20)  // 浅   停滞
cLitB  = color.new(#7fb0e0, 0)   // 浅蓝 弱进场
cDeepB = color.new(#2f7fd0, 0)   // 深蓝 高位进场
cBriB  = color.new(#1e90ff, 0)   // 亮蓝 加速进场(机构累积最强)

mcol = z < -1.26 ? cDeepR : z < -0.53 ? cBriR : z < -0.29 ? cLitR : z < 0.36 ? cFlat : z < 1.14 ? cLitB : z < 1.83 ? cDeepB : cBriB
plot(z, "动能", color=mcol, style=plot.style_area, linewidth=2)
hline(0, "0轴", color=color.new(color.gray, 50))
hline(1.83, "亮蓝阈", color=color.new(#1e90ff, 70), linestyle=hline.style_dotted)
hline(-1.26, "深红阈", color=color.new(#a01020, 70), linestyle=hline.style_dotted)
